#!/bin/sh
set -e

# Block committing sensitive files by name/pattern, but allow example files
STAGED_FILES=$(git diff --cached --name-only)

FORBIDDEN=""
for f in $STAGED_FILES; do
  base=$(basename "$f")

  # Always block .npmrc
  if [ "$base" = ".npmrc" ]; then
    FORBIDDEN="$FORBIDDEN\n$f"
    continue
  fi

  # Block env files like .env, .env.local, .env.production but allow *.example
  if echo "$base" | grep -E '^\.env(\..+)?$' >/dev/null 2>&1; then
    if [ "$base" != ".env.example" ] && ! echo "$base" | grep -E '\.example$' >/dev/null 2>&1; then
      FORBIDDEN="$FORBIDDEN\n$f"
      continue
    fi
  fi

  # Block key/cert files, allow *.example
  if echo "$base" | grep -E '\.(pem|key|crt)(\..*)?$' >/dev/null 2>&1; then
    if ! echo "$base" | grep -E '\.example$' >/dev/null 2>&1; then
      FORBIDDEN="$FORBIDDEN\n$f"
      continue
    fi
  fi
done

if [ -n "$FORBIDDEN" ]; then
  echo "\n❌ Güvenlik hatası: .env/.npmrc veya anahtar/sertifika dosyaları commit edilemez."
  echo "Lütfen bu dosyaları .gitignore ile hariç tutun ve staged durumdan çıkarın."
  echo "İptal edilen dosyalar:"
  # trim leading newline before printing
  echo "$FORBIDDEN" | sed '/^$/d'
  exit 1
fi

# Optional: run gitleaks if installed (scans staged changes)
if command -v gitleaks >/dev/null 2>&1; then
  echo "🔎 Gitleaks ile gizli anahtar taraması yapılıyor..."
  gitleaks detect --no-banner --redact --staged --config .gitleaks.toml
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo "❌ Gitleaks gizli bilgi tespit etti. Commit iptal edildi."
    exit $STATUS
  fi
else
  echo "ℹ️ Gitleaks bulunamadı, yalnızca dosya adı kontrolleri yapıldı."
fi

exit 0
